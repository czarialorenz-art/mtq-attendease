# MTQ-ATTENDEASE — production settings for InfinityFree
# Copy this file to the server as ".env" (in htdocs, next to artisan) and fill in the CHANGE_ME values.
# Never upload your local .env.

APP_NAME="MTQ-ATTENDEASE"
APP_ENV=production
# CHANGE_ME: copy APP_KEY from your local .env (same key = existing data stays readable)
APP_KEY=
APP_DEBUG=false
# CHANGE_ME: your real https address, e.g. https://mtq-attendease.infinityfreeapp.com
APP_URL=https://CHANGE_ME.infinityfreeapp.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=single
LOG_LEVEL=error
LOG_DEPRECATIONS_CHANNEL=null

# CHANGE_ME: from InfinityFree control panel > MySQL Databases (the host is NOT localhost)
DB_CONNECTION=mysql
DB_HOST=sqlXXX.infinityfree.com
DB_PORT=3306
DB_DATABASE=if0_XXXXXXXX_mtq_attendease
DB_USERNAME=if0_XXXXXXXX
DB_PASSWORD=CHANGE_ME

# No Redis, no queue worker, no cron on InfinityFree
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Security alert emails are written to storage/logs instead of sent
# (InfinityFree's free plan has no PHP mail()). To try Gmail SMTP instead:
# MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME=you@gmail.com, MAIL_PASSWORD=<16-character App Password>
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="MTQ-ATTENDEASE"
